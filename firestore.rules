rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras para coleções públicas (acessíveis por qualquer usuário autenticado)
    match /materials/{materialId} {
      allow read, write: if request.auth != null;
    }
    
    match /chatHistory/{chatId} {
      allow read, write: if request.auth != null;
    }
    
    match /quizHistory/{quizId} {
      allow read, write: if request.auth != null;
    }

    // Regra para dados do usuário: permite que um usuário leia e escreva apenas em seus próprios documentos
    // Isso cobre subcoleções como 'library' e 'settings'
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}